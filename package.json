{
  "name": "pls-touch-grass-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.Rinava/pls-touch-grass",
  "description": "An MCP server that knows how long it's been since you touched grass",
  "type": "module",
  "license": "MIT",
  "author": "Lara Mateo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinava/pls-touch-grass-mcp.git"
  },
  "homepage": "https://github.com/Rinava/pls-touch-grass-mcp#readme",
  "bugs": {
    "url": "https://github.com/Rinava/pls-touch-grass-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "model-context-protocol",
    "cursor",
    "claude",
    "ai",
    "productivity",
    "break-reminder",
    "touch-grass"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pls-touch-grass-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "test": "npm run build && node --test",
    "probe": "npm run build && node scripts/probe.mjs",
    "probe:live": "node scripts/probe.mjs --live",
    "mcp:local": "(claude mcp remove pls-touch-grass -s local >/dev/null 2>&1 || true) && claude mcp add pls-touch-grass -s local -- sh -c \"cd '$PWD' && ./node_modules/.bin/tsc 1>&2 && exec node dist/index.js\"",
    "mcp:npm": "claude mcp remove pls-touch-grass -s local",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^20.0.0"
  }
}
